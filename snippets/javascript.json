	"Use intersection observer": {
		"prefix": "useobserve",
		"body": [
			"import { useIntersectionObserver } from \"@vueuse/core\";",
			"",
			"//",
			"const ${showElement} = ref(false);",
			"// A reference to our list, allowing us to observe it.",
			"const ${element}Element = useTemplateRef(\"${element}\");",
			"",
			"const { stop } = useIntersectionObserver(${element}Element, ([{ isIntersecting }]) => {",
			"\t${showElement}.value = isIntersecting;",
			"",
			"\tif (isIntersecting) {",
			"\t\tstop();",
			"\t}",
			"}, { threshold: 0.3 });"
		]
	},
