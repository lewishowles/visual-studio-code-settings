	"Router": {
		"prefix": "router",
		"body": [
			"import { createRouter, createWebHistory } from \"vue-router\";",
			"import PageHome from \"@/views/page-home/page-home.vue\";",
			"",
			"const router = createRouter({",
			"\thistory: createWebHistory(import.meta.env.BASE_URL),",
			"\troutes: [",
			"\t\t{",
			"\t\t\tpath: \"/\",",
			"\t\t\tname: \"home\",",
			"\t\t\tcomponent: PageHome,",
			"\t\t},",
			"\t\t//{",
			"\t\t//\tpath: \"/about\",",
			"\t\t//\tname: \"about\",",
			"\t\t//\tcomponent: () => import(\"@/views/page-about/page-about.vue\"),",
			"\t\t//},",
			"\t],",
			"\tscrollBehavior(to, from, savedPosition) {",
			"\t\tif (to.hash) {",
			"\t\t\treturn { el: to.hash };",
			"\t\t}",
			"",
			"\t\tif (savedPosition) {",
			"\t\t\treturn savedPosition;",
			"\t\t}",
			"",
			"\t\treturn { top: 0 };",
			"\t},",
			"});",
			"",
			"export default router;"
		]
	},
