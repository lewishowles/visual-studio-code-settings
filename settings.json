{
	"security.workspace.trust.untrustedFiles": "open",
	"security.promptForLocalFileProtocolHandling": false,
	"editor.fontSize": 15,
	"editor.fontFamily": "'IBM Plex Mono', 'JetBrains Mono', Menlo, Monaco, 'Courier New', monospace",
	"editor.rulers": [80],
	"editor.semanticHighlighting.enabled": true,
	"editor.insertSpaces": false,
	"editor.detectIndentation": false,
	"tws.highlightTrailingWhiteSpace": true,
	"indentRainbow.indicatorStyle": "light",
	"editor.quickSuggestions": "off",
	"editor.snippetSuggestions": "top",
	"editor.tabCompletion": "onlySnippets",

	"editor.defaultFormatter": "oxc.oxc-vscode",
	"[javascript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode",
	},
	"[typescript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode",
	},
	"[vue]": {
		"editor.defaultFormatter": "oxc.oxc-vscode",
	},
	"editor.formatOnSave": true,
	"editor.formatOnSaveMode": "file",
	"editor.codeActionsOnSave": {
		"source.fixAll.oxc": "explicit",
	},
	"oxc.requireConfig": true,
	"markdownlint.config": {
		"no-hard-tabs": {
			"code_blocks": false,
		},
	},
	"xml.format.joinContentLines": true,
	"xml.format.maxLineWidth": 0,

	"npm.scriptRunner": "vp",

	"terminal.integrated.fontFamily": "'MesloLGS NF', Menlo, Monaco, 'Courier New', monospace",

	"workbench.colorTheme": "Tokyo Night Storm",
	"workbench.iconTheme": "material-icon-theme",
	"workbench.colorCustomizations": {
		"editor.selectionHighlightBackground": "#C3E88D80",
		"editor.wordHighlightBackground": "#C3E88D80",
		"debugConsole.foreground": "#BEC7D5",
	},
	"workbench.startupEditor": "none",
	"workbench.editor.enablePreview": false,
	"workbench.editor.wrapTabs": true,
	"workbench.editorAssociations": {
		"*.svg": "default",
	},

	"window.confirmSaveUntitledWorkspace": false,

	"emmet.includeLanguages": {
		"astro": "html",
		"mdx": "html",
	},
	"cSpell.language": "en-GB",
	"cSpell.userWords": [
		"anpr",
		"artboards",
		"boilersuit",
		"Colada",
		"colors",
		"composables",
		"describedby",
		"dialog",
		"dialogs",
		"frontmatter",
		"Gists",
		"Howles",
		"Labelledby",
		"lewishowles",
		"ltrim",
		"nanoid",
		"Nums",
		"pinia",
		"tailwindcss",
		"toggletip",
		"vars",
		"VITE",
		"Vitest",
		"vnodes",
		"Xano",
	],
	"files.defaultLanguage": "${activeEditorLanguage}",
	"files.exclude": {
		"**/dist/**": true,
		"**/build/**": true,
		"**/node_modules/**": true,
	},
	"git.openRepositoryInParentFolders": "never",
	"git.ignoreMissingGitWarning": true,
	"search.quickOpen.includeHistory": false,
	"astro.updateImportsOnFileMove.enabled": true,
	"js/ts.updateImportsOnFileMove.enabled": "always",
	"markdown.updateLinksOnFileMove.enabled": "always",
	"advancedNewFile.convenienceOptions": ["current", "root"],
	"codesnap.shutterAction": "copy",
	"todo-tree.general.statusBar": "tags",
	"chat.agent.enabled": false,
	"explorer.confirmDragAndDrop": false,
	"chat.disableAIFeatures": true,
}
