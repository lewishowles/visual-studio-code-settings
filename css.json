	"Width full": {
		"prefix": "wf",
		"body": [
			"width: 100%;",
		],
	},
	"Text color": {
		"prefix": ["color", "text"],
		"body": [
			"color: var(--colour-${color}-${shade});",
		],
	},
	"Shadow 2xs": {
		"prefix": [
			"shadow-2xs",
			"shadow2xs"
		],
		"body": "box-shadow: 0 1px rgb(0 0 0 / 0.05);",
	},
	"Shadow xs": {
		"prefix": [
			"shadow-xs",
			"shadowxs"
		],
		"body": "box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);",
	},
	"Shadow sm": {
		"prefix": [
			"shadow-sm",
			"shadowsm"
		],
		"body": "box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);",
	},
	"Shadow md": {
		"prefix": [
			"shadow-md",
			"shadowmd"
		],
		"body": "box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);",
	},
	"Shadow lg": {
		"prefix": [
			"shadow-lg",
			"shadowlg"
		],
		"body": "box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);",
	},
	"Shadow xl": {
		"prefix": [
			"shadow-xl",
			"shadowxl"
		],
		"body": "box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);",
	},
	"Shadow 2xl": {
		"prefix": [
			"shadow-2xl",
			"shadow2xl"
		],
		"body": "box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);",
	},
