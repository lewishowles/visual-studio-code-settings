{
	"Dark mode": {
		"prefix": "dark",
		"body": [
			"&:where(.dark, .dark *) ",
		],
	},

	"Motion safe": {
		"prefix": "ms",
		"body": [
			"@media (prefers-reduced-motion: no-preference) {",
		],
	},

	"Media query - sm": {
		"prefix": "mqs",
		"body": [
			"@media (min-width: 640px) {",
			"\t${1}",
			"}",
		],
	},

	"Media query - md": {
		"prefix": "mqm",
		"body": [
			"@media (min-width: 768px) {",
			"\t${1}",
			"}",
		],
	},

	"Media query - lg": {
		"prefix": "mql",
		"body": [
			"@media (min-width: 1024px) {",
			"\t${1}",
			"}",
		],
	},

	"Media query - xl": {
		"prefix": "mqxl",
		"body": [
			"@media (min-width: 1280px) {",
			"\t${1}",
			"}",
		],
	},

	"Media query - 2xl": {
		"prefix": "mq2xl",
		"body": [
			"@media (min-width: 1536px) {",
			"\t${1}",
			"}",
		],
	},

	"Linear gradient": {
		"prefix": ["grad", "gradient"],
		"body": [
			"background-image: linear-gradient(to bottom, ${1:start}, ${2:end});",
		],
	},
}
